{
  "name": "aispeeds",
  "version": "1.0.0",
  "packageManager": "pnpm@10.18.1",
  "type": "module",
  "scripts": {
    "prepare:homepage": "node scripts/prepare-cc4pm-homepage.mjs",
    "build": "pnpm run prepare:homepage && next build",
    "dev": "pnpm run prepare:homepage && cross-env NODE_NO_WARNINGS=1 next dev --turbopack # Next.js 开发服务器（带 Turbopack 加速）",
    "cf:build": "pnpm run prepare:homepage && opennextjs-cloudflare build # 构建 Cloudflare Workers 版本",
    "cf:preview": "pnpm cf:build && opennextjs-cloudflare preview # 预览 Cloudflare 构建结果",
    "cf:deploy": "pnpm cf:build && opennextjs-cloudflare deploy # 部署到 Cloudflare Workers",
    "prepare": "husky # 安装 Git hooks（自动设置 husky）",
    "lint": "eslint . --fix # ESLint 检查并自动修复代码问题",
    "lint:check": "eslint .",
    "format": "prettier --write . # Prettier 格式化所有代码文件",
    "shares:prepare": "node scripts/prepare-share-assets.mjs",
    "shares:validate": "node --experimental-strip-types scripts/validate-share-assets.ts",
    "shares:publish": "node scripts/publish-share-assets.mjs",
    "typecheck": "tsc --noEmit # TypeScript 类型检查（不生成文件）",
    "audit": "pnpm audit --audit-level=moderate # 安全审计：检查依赖漏洞"
  },
  "keywords": [],
  "author": "xiaohui",
  "license": "MIT",
  "description": "Make AI Speeds Us and Provide Universal Claude API Proxy",
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@opennextjs/cloudflare": "^1.19.5",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "autoprefixer": "^10.5.0",
    "commitizen": "^4.3.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-security": "^4.0.0",
    "highlight.js": "^11.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "markdown-it": "^14.1.1",
    "postcss": "^8.5.13",
    "prettier": "^3.8.3",
    "punycode": "^2.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "wrangler": "4.131.1"
  },
  "dependencies": {
    "@cc4pm/homepage": "^1.0.13",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "isomorphic-dompurify": "^3.11.0",
    "lucide-react": "^1.14.0",
    "next": "^15.5.15",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  }
}
